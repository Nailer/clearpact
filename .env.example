# ── Copy to .env and fill in. NEVER commit .env ──────────────────

# Circle auth comes in two parts:
# 1. Circle CLI (agent wallets, gateway, x402): `circle wallet login` (email + OTP,
#    stored under ~/.circle) — run once manually. No key needed here.
# 2. Circle REST APIs (Circle Wallets / Circle Contracts): standard "API Key"
#    from https://console.circle.com (choose the API Key type, TESTNET).
#    A "Kit Key" (App Kit/Swap Kit) will be added in Part 6 for the dashboard.
#    "Client Key" (Modular Wallets SDK) is NOT needed.
CIRCLE_API_KEY=

# Anthropic API key for the agents (buyer / worker / verifier LLM brains)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Deployer wallet private key (testnet-only wallet, fund via https://faucet.circle.com)
DEPLOYER_PRIVATE_KEY=

# Arc testnet (verified live 24 Jul 2026)
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER=https://testnet.arcscan.app

# Optional: ArcScan API key for contract verification
ARCSCAN_API_KEY=
